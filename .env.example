# คัดลอกไฟล์นี้เป็น .env แล้วใส่ key ของตัวเอง
# GISTDA API Gateway: สมัครที่ https://api-gateway.gistda.or.th (ข้อมูลน้ำท่วมจากดาวเทียม)
GISTDA_API_KEY=
# Longdo Map: สมัครที่ https://map.longdo.com/console (ลงทะเบียน host เช่น localhost)
LONGDO_API_KEY=
PORT=3000
# นอกจากสถานีในจังหวัด ให้รวมสถานีจังหวัดข้างเคียงในรัศมีนี้จากตัวเมือง (กม.)
RADIUS_KM=70
